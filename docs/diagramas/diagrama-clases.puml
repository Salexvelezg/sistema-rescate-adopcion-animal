
@startuml
skinparam classAttributeIconSize 0

abstract class ExpedienteAnimal {
  - id: int
  - nombre: String
  - ubicacion: String
  - estado: EstadoCaso
  + actualizarEstado(estado: EstadoCaso): void
}

class Perro {
  - raza: String
  - edad: int
}

class Gato {
  - raza: String
  - edad: int
}

class FaunaSilvestre {
  - especie: String
  - nivelRiesgo: String
}

enum EstadoCaso {
  REPORTADO
  RESCATADO
  EN_TRATAMIENTO
  DISPONIBLE_ADOPCION
  ADOPTADO
  CERRADO
}

class Usuario {
  - id: int
  - nombre: String
  - correo: String
  - rol: String
}

class Asignacion {
  - fecha: Date
  - observaciones: String
}

class RegistroAtencion {
  - fecha: Date
  - diagnostico: String
  - tratamiento: String
}

class SolicitudAdopcion {
  - id: int
  - fecha: Date
  - estado: String
}

class GestorCasos {
  - instancia: GestorCasos
  + obtenerInstancia(): GestorCasos
  + registrarCaso(caso: ExpedienteAnimal): void
  + buscarCaso(id: int): ExpedienteAnimal
}

class FabricaExpedientes {
  + crearExpediente(tipo: String): ExpedienteAnimal
}

interface ObservadorCaso {
  + actualizar(caso: ExpedienteAnimal): void
}

class Notificador {
  + suscribir(obs: ObservadorCaso): void
  + notificar(caso: ExpedienteAnimal): void
}

class NotificacionVoluntario {
  + actualizar(caso: ExpedienteAnimal): void
}

ExpedienteAnimal <|-- Perro
ExpedienteAnimal <|-- Gato
ExpedienteAnimal <|-- FaunaSilvestre
ExpedienteAnimal --> EstadoCaso

Usuario "1" -- "0..*" Asignacion
ExpedienteAnimal "1" -- "0..*" Asignacion
ExpedienteAnimal "1" -- "0..*" RegistroAtencion
Usuario "1" -- "0..*" SolicitudAdopcion
ExpedienteAnimal "1" -- "0..*" SolicitudAdopcion

GestorCasos ..> ExpedienteAnimal
FabricaExpedientes ..> ExpedienteAnimal
Notificador o-- ObservadorCaso
ObservadorCaso <|.. NotificacionVoluntario

@enduml
